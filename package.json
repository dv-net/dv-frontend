{
	"name": "dv-frontend",
	"private": false,
	"version": "1.1.1",
	"type": "module",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "APP_NAME=dv-admin vite",
		"dev:pay": "APP_NAME=pay vite",
		"dev:pay-simple": "APP_NAME=pay-simple vite",
		"build:dv-admin": "APP_NAME=dv-admin vite build",
		"build:pay": "APP_NAME=pay vite build",
		"build:pay-simple": "APP_NAME=pay-simple vite build",
		"build": "run-p type:check \"build-only {@}\" --",
		"build-only": "npm-run-all --parallel build:dv-admin build:pay build:pay-simple",
		"preview": "APP_NAME=dv-admin vite preview",
		"preview:pay": "APP_NAME=pay vite preview",
		"preview:pay-simple": "APP_NAME=pay-simple vite preview",
		"type:check": "vue-tsc --build --force",
		"lint": "eslint shared pay-shared apps",
		"lint:fix": "eslint shared pay-shared apps --fix",
		"format": "prettier --write shared pay-shared apps",
		"i18n:dv-admin": "dv-translator translate --dir apps/dv-admin/src/utils/libs/i18n/locales -l ar,bn,bg,es,zh,de,pl,pt,sw,uk,fr,ja,cs,da,el,et,fi,hu,id,it,ko,lt,lv,nb,nl,ro,sk,sl,sv,tr,hi,vi -t 10 -m gpt-5.5 --context 'Crypto payments merchant admin UI'",
		"i18n:pay": "dv-translator translate --dir pay-shared/utils/libs/i18n/locales -l ar,bn,bg,es,zh,de,pl,pt,sw,uk,fr,ja,cs,da,el,et,fi,hu,id,it,ko,lt,lv,nb,nl,ro,sk,sl,sv,tr,hi,vi -t 10 -m gpt-5.5 --context 'Crypto payments merchant UI'",
		"i18n:status:dv-admin": "dv-translator status --dir apps/dv-admin/src/utils/libs/i18n/locales",
		"i18n:status:pay": "dv-translator status --dir pay-shared/utils/libs/i18n/locales",
		"i18n:prune:dv-admin": "dv-translator prune --dir apps/dv-admin/src/utils/libs/i18n/locales",
		"i18n:prune:pay": "dv-translator prune --dir pay-shared/utils/libs/i18n/locales"
	},
	"dependencies": {
		"@dv.net/ui-kit": "^7.7.18",
		"@reown/appkit": "1.8.24",
		"@reown/appkit-adapter-wagmi": "1.8.24",
		"@tanstack/vue-query": "5.104.0",
		"@wagmi/vue": "0.5.30",
		"axios": "^1.20.0",
		"chart.js": "^4.5.1",
		"chartjs-plugin-crosshair": "^2.0.0",
		"dayjs": "^1.11.23",
		"js-cookie": "^3.0.8",
		"jspdf": "^4.2.1",
		"lottie-web-vue": "^3.0.1",
		"pinia": "^4.0.3",
		"qrcode.vue": "^3.11.0",
		"transliteration": "2.6.1",
		"viem": "2.57.0",
		"vue": "^3.5.43",
		"vue-chartjs": "^5.3.4",
		"vue-i18n": "^11.4.12",
		"vue-router": "^5.3.1",
		"vue-turnstile": "^1.0.11",
		"vue-virtual-scroller": "3.0.5",
		"vue3-cookies": "^1.0.6"
	},
	"devDependencies": {
		"@dv.net/translator": "^2.0.0",
		"@rushstack/eslint-patch": "^1.16.1",
		"@tsconfig/node20": "^20.1.10",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^26.6.3",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.11.0",
		"eslint-plugin-vue": "^10.11.1",
		"npm-run-all2": "^9.0.3",
		"prettier": "^3.9.9",
		"sass": "1.105.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.1",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.3.11"
	}
}
